{
  "name": "@local/dsh-plugin-devkit",
  "version": "0.1.0",
  "description": "Plugin developer workbench for DeepSeek Harness: scaffold generation, runtime exploration, one-click local install, declaration validation",
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./lib/*": "./lib/*"
  },
  "files": [
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "index.js",
    "lib/*.js",
    "lib/templates/*.js",
    "locale/*.json",
    "README.md",
    "README.zh.md"
  ],
  "scripts": {
    "test": "node --test ./tests/*.test.mjs",
    "check": "node --check index.js && node --check client.js && node --test ./tests/*.test.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}