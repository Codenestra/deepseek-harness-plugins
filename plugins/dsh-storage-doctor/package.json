{
  "name": "@local/dsh-storage-doctor",
  "version": "0.1.0",
  "description": "Disk health visualization and retention-based safe cleanup for the DeepSeek Harness home (~/.dsh)",
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./lib/*": "./lib/*"
  },
  "files": [
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "index.js",
    "lib/*.js",
    "locale/*.json",
    "README.md",
    "README.zh.md",
    "INSTALL.zh.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js"
  },
  "author": "Codenestra",
  "repository": {
    "type": "git",
    "url": "https://github.com/Codenestra/deepseek-harness-plugins.git",
    "directory": "plugins/dsh-storage-doctor"
  },
  "homepage": "https://github.com/Codenestra/deepseek-harness-plugins/tree/main/plugins/dsh-storage-doctor",
  "bugs": {
    "url": "https://github.com/Codenestra/deepseek-harness-plugins/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh-storage-doctor"
  ]
}
