{
  "name": "@local/dsh-runaway-watchdog",
  "version": "1.2.1",
  "description": "Harness-level runaway detection and spend circuit breaker with categorized per-model RMB pricing for DeepSeek Harness",
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./lib/*": "./lib/*"
  },
  "files": [
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "index.js",
    "lib/*.js",
    "locale/*.json",
    "README.md",
    "README.zh.md",
    "TEST_REPORT.md",
    "INSTALL.md",
    "GUIDE.md",
    "tools/*.mjs",
    "tests/*.test.mjs"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node tests/e2e/real-host.e2e.mjs",
    "repair:context": "node tools/repair-role-less-context.mjs",
    "check": "node --check index.js && node --check client.js && node --test tests/*.test.mjs",
    "verify": "node --check index.js && node --check client.js && node --test tests/*.test.mjs && node tests/e2e/real-host.e2e.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  }
}